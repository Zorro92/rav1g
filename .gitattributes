# Code of other projects kept in this tree, marked for GitHub's language statistics. The decoder is
# Rust and HLSL; none of the files below is compiled into it.

# libaom: the reference the shader checks of testing/ hold the shaders against, and the files the
# decoder's build and tests read tables from as text. Its shaders (libav1/dx) are rav1g's own.
libav1/aom/** linguist-vendored
libav1/aom_dsp/** linguist-vendored
libav1/aom_mem/** linguist-vendored
libav1/aom_ports/** linguist-vendored
libav1/aom_scale/** linguist-vendored
libav1/aom_util/** linguist-vendored
libav1/av1/** linguist-vendored
libav1/build/** linguist-vendored

# The WebM parser of the test player, and the file readers of aomdec and Microsoft's D3D12 helper
# header the test player uses.
third_party/libwebm/** linguist-vendored
testing/common/d3dx12.h linguist-vendored
testing/common/ivfdec.* linguist-vendored
testing/common/obudec.* linguist-vendored
testing/common/webmdec.* linguist-vendored
testing/common/tools_common.* linguist-vendored
testing/common/md5_utils.* linguist-vendored

# The headers the shaders include are HLSL, not C.
libav1/dx/shaders/*.h linguist-language=HLSL

# Test tooling, kept out of the language statistics so that they describe the decoder: the UWP test
# player (C++), the shader and parser checks against the C++ reference, the conformance scripts
# (Python), and the C++ glue of rav1g-dec's player smoke test. The decoder's own C is its public
# header (crates/rav1g/include/rav1g.h) and the perf struct and shader table the C side shares.
testing/** linguist-detectable=false
tools/rav1g-dec/shim/** linguist-detectable=false
# The C++ original of the -intrav2 schedule: the decoder has its port (crates/rav1g/src/host/intra_v2.rs);
# the header is the reference testing/intra_check holds the port against.
libav1/dx/intra_v2_sched.h linguist-detectable=false
