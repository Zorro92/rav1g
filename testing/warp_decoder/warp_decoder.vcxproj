<?xml version="1.0" encoding="utf-8"?>
<!--
  warp_decoder: the decoder as a desktop (Win32) console program; see docs/warp-decoder.md.

  libav1/build/libav1.vcxproj builds the library for a Windows Store app container, which a desktop
  program cannot reference. So this project compiles the library's sources and shaders itself, with the
  settings the library project gives them in Release x64 (libav1_sources.props, written by
  sync_sources.py), next to the stream readers of testing/common and its own main.cpp. It is not part of
  av1xbox.sln and does not touch what the solution builds: the shader headers go to this project's own
  intermediate directory, not to libav1/dx/shaders/h.

    msbuild testing\warp_decoder\warp_decoder.vcxproj /p:Configuration=Release /p:Platform=x64
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{911CE11E-9B58-45ED-BC40-0D95DD6D4B7C}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>warp_decoder</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>warp_decoder</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <GenerateManifest>true</GenerateManifest>
    <!-- The shader headers of this build: av1_compute.cpp includes them as "dx/shaders/h/<name>.h". -->
    <ShaderHeaderRoot>$(IntDir)shaders_h\</ShaderHeaderRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>false</CompileAsWinRT>
      <SDLCheck>true</SDLCheck>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <DisableSpecificWarnings>4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- The headers of this build first, then the include directories of libav1 and uwp_common. -->
      <AdditionalIncludeDirectories>$(ShaderHeaderRoot);$(RepoRoot)libav1;$(RepoRoot)libav1\build;$(RepoRoot)testing;$(RepoRoot)third_party\libwebm;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- As in libav1.vcxproj: no NDEBUG, so the library's asserts are compiled in, as they are in the player. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_UNICODE;UNICODE;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>d3d12.lib;dxgi.lib;dxguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <GenerateMapFile>true</GenerateMapFile>
    </Link>
    <!-- The shader settings of libav1.vcxproj: cs_5_0, entry point main, bytecode as a header. -->
    <FxCompile>
      <VariableName>%(Filename)</VariableName>
      <HeaderFileOutput>$(ShaderHeaderRoot)dx\shaders\h\%(Filename).h</HeaderFileOutput>
      <ShaderModel>5.0</ShaderModel>
      <ShaderType>Compute</ShaderType>
      <ObjectFileOutput />
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <FxCompile>
      <DisableOptimizations>true</DisableOptimizations>
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <!-- libav1.vcxproj, Release x64: /O1 /Ot, and /O2 for the files libav1_sources.props marks. -->
      <Optimization>MinSpace</Optimization>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
    <FxCompile>
      <DisableOptimizations>false</DisableOptimizations>
    </FxCompile>
  </ItemDefinitionGroup>
  <!-- /p:Rav1gUavSync=1: the experiment build in which every group sync of the shaders is a sync of all
       memory (AllMemoryBarrierWithGroupSync), for a device on which a store to the frame buffer by one
       thread is not seen by another thread of the group behind a sync of the group memory alone. -->
  <ItemDefinitionGroup Condition="'$(Rav1gUavSync)'=='1'">
    <ClCompile>
      <PreprocessorDefinitions>RAV1G_UAVSYNC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <FxCompile>
      <PreprocessorDefinitions>GroupMemoryBarrierWithGroupSync=AllMemoryBarrierWithGroupSync;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </FxCompile>
  </ItemDefinitionGroup>
  <!-- /p:Rav1gPrebuiltShaders=<directory>: the bytecode headers of the shaders are in
       <directory>\dx\shaders\h, written by testing/shader_cache/shaders.py from one FXC call per shader
       that also wrote the shader's listing, and this project compiles no shader. The CI builds set it
       (.github/actions/shaders); without it the project compiles its shaders itself, as it always did. -->
  <ItemDefinitionGroup Condition="'$(Rav1gPrebuiltShaders)'!=''">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Rav1gPrebuiltShaders);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- /p:Rav1gSm6TestShaders=<directory>: the shaders of the Shader Model 6 test (-sm6test), compiled with
       DXC by testing/sm6test/compile.py into <directory>\sm6test_generated\shaders.h. They are not shaders
       of the decoder and this project does not compile them: without the property -sm6test says that the
       test shaders are not built in. The CI builds set it. -->
  <ItemDefinitionGroup Condition="'$(Rav1gSm6TestShaders)'!=''">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Rav1gSm6TestShaders);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RAV1G_SM6TEST_SHADERS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- The sources and shaders of libav1.vcxproj. -->
  <Import Project="libav1_sources.props" />
  <!-- The stream readers and md5 of the test player (testing/uwp_common), and libwebm's parser. -->
  <ItemGroup>
    <ClCompile Include="$(RepoRoot)third_party\libwebm\mkvparser\mkvparser.cc" />
    <ClCompile Include="$(RepoRoot)third_party\libwebm\mkvparser\mkvreader.cc" />
    <ClCompile Include="$(RepoRoot)testing\common\ivfdec.c" />
    <ClCompile Include="$(RepoRoot)testing\common\log.cpp" />
    <ClCompile Include="$(RepoRoot)testing\common\md5_utils.c" />
    <ClCompile Include="$(RepoRoot)testing\common\mp4parser.cc" />
    <ClCompile Include="$(RepoRoot)testing\common\obudec.c" />
    <ClCompile Include="$(RepoRoot)testing\common\stream_reader.cpp" />
    <ClCompile Include="$(RepoRoot)testing\common\tools_common.c" />
    <ClCompile Include="$(RepoRoot)testing\common\webmdec.cc" />
    <!-- The capability report and the Shader Model 6 test (-sm6test), shared with the test player. -->
    <ClCompile Include="$(RepoRoot)testing\sm6test\sm6test.cpp" />
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <!-- /p:Rav1gPrebuiltShaders: no shader is compiled here (see the item definitions above). The items are
       taken out, not marked as excluded: some of them carry an ExcludedFromBuild of their own, which would
       win over a default. -->
  <ItemGroup Condition="'$(Rav1gPrebuiltShaders)'!=''">
    <FxCompile Remove="@(FxCompile)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="MakeShaderHeaderDirectory" BeforeTargets="FxCompile">
    <MakeDir Directories="$(ShaderHeaderRoot)dx\shaders\h" />
  </Target>
</Project>
