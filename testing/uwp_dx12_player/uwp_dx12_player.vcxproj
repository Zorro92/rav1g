  <Target Name="Rav1gLibraryIsGiven" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Rav1gRustDll)$(Rav1gRustLib)'==''" Text="The player links the Rust library of the Cargo workspace: build it first and pass /p:Rav1gRustDll=&lt;directory with rav1g.dll and rav1g.dll.lib&gt; or /p:Rav1gRustLib=&lt;directory with rav1g.lib&gt; (docs/test-player.md, &quot;Building&quot;; .github/workflows/build.yml has the commands)." />
    <Error Condition="'$(Rav1gRustDll)'!='' And '$(Rav1gRustLib)'!=''" Text="Rav1gRustDll and Rav1gRustLib are both set: the player links one library." />
  </Target>
  <PropertyGroup>
    <Rav1gDxc>$(WindowsSdkDir)bin\$(WindowsTargetPlatformVersion)\x64\dxc.exe</Rav1gDxc>
  </PropertyGroup>
  <Target Name="Rav1gCompilePlayerShaders" BeforeTargets="ClCompile"
          Inputs="$(Rav1gDxc);$(MSBuildProjectFullPath);SamplePixelShader.hlsl;SampleVertexShader.hlsl;ps_cbuf.h"
          Outputs="$(IntDir)rav1g-shaders\SamplePixelShader.h;$(IntDir)rav1g-shaders\SampleVertexShader.h">
    <MakeDir Directories="$(IntDir)rav1g-shaders" />
    <Exec Command="&quot;$(Rav1gDxc)&quot; -nologo -T ps_6_0 -E main -HV 2018 -WX -Vn SamplePixelShader -Fh &quot;$(IntDir)rav1g-shaders\SamplePixelShader.h&quot; &quot;$(ProjectDir)SamplePixelShader.hlsl&quot;" />
    <Exec Command="&quot;$(Rav1gDxc)&quot; -nologo -T vs_6_0 -E main -HV 2018 -WX -Vn SampleVertexShader -Fh &quot;$(IntDir)rav1g-shaders\SampleVertexShader.h&quot; &quot;$(ProjectDir)SampleVertexShader.hlsl&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntDir)rav1g-shaders\SamplePixelShader.h;$(IntDir)rav1g-shaders\SampleVertexShader.h" />
    </ItemGroup>
  </Target>
