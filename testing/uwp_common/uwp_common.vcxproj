  <!-- /p:Rav1gSm6TestShaders=<directory>: the shaders of the Shader Model 6 test (-sm6test), compiled with
       DXC by testing/sm6test/compile.py into <directory>\sm6test_generated\shaders.h. They are not shaders
       of the decoder and no project compiles them: without the property -sm6test says that the test
       shaders are not built in. The CI builds set it. -->
  <ItemDefinitionGroup Condition="'$(Rav1gSm6TestShaders)'!=''">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Rav1gSm6TestShaders);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RAV1G_SM6TEST_SHADERS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
